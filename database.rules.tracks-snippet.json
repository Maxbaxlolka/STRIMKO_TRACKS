{
  "tracks": {
    "publicSettings": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "active": {
      ".read": true,
      ".write": "auth != null"
    },
    "queue": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sessions": {
      ".read": false,
      ".write": false
    },
    "userOrders": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null"
      }
    },
    "orderOwners": {
      ".read": false,
      ".write": "auth != null"
    },
    "viewerIds": {
      ".read": false,
      ".write": false
    }
  }
}
